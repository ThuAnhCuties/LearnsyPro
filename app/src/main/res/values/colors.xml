    <!-- Hồng pastel - màu chủ đạo (đồng bộ với DashboardColorsLight.accent #F472B6 của
         Learnsy Pro — trước đây là "pastel_blue", đổi tông nhưng GIỮ NGUYÊN tên biến để
         mọi layout/style tham chiếu @color/primary, @color/pastel_blue_500... không cần sửa. -->
    <color name="pastel_blue_50">#FFF0F7</color>
    <color name="pastel_blue_100">#FEE1EF</color>
    <color name="pastel_blue_200">#FDC3E0</color>
    <color name="pastel_blue_300">#FBA5CF</color>
    <color name="pastel_blue_400">#F787BE</color>
