<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Fixed: phải kế thừa Material Components để có ?attr/actionBarSize, selectableItemBackgroundBorderless... -->
    <style name="Theme.Learnsy" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/primary</item>
        <item name="colorOnPrimary">@color/on_primary</item>
        <item name="colorSurface">@color/surface</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="android:colorBackground">@color/background</item>
        <!-- Nền status bar khớp màu LightBackground (#FFF8FB) để tránh đen thui lúc khởi động -->
        <item name="android:statusBarColor">#FFF8FB</item>
        <item name="android:navigationBarColor">#FFF8FB</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="27">true</item>
    </style>

    <!-- ═══ Theme cho module Quản lý tệp (FTP/SFTP/SMB/Cloud) ═══ -->
<style name="Theme.MyFile" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/primary</item>
        <item name="colorOnPrimary">@color/on_primary</item>
        <item name="colorPrimaryContainer">@color/pastel_blue_100</item>
        <item name="colorOnPrimaryContainer">@color/primary_dark</item>
        <item name="colorSecondary">@color/pastel_blue_400</item>
        <item name="colorSurface">@color/surface</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="android:colorBackground">@color/background</item>
        <item name="colorOutline">@color/outline</item>
        <item name="android:statusBarColor">@color/surface</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:navigationBarColor">@color/surface</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="27">true</item>
        <item name="materialCardViewStyle">@style/App.CardView</item>
        <item name="android:fontFamily">sans-serif</item>
        <!-- toolbarStyle mặc định trỏ vào App.Toolbar: KHÔNG có Toolbar nào trong toàn app khai
             style="@style/App.Toolbar" tường minh trong layout XML (đã rà toàn bộ layout/), nên
             định nghĩa style riêng ở trên không hề có tác dụng cho tới khi gắn vào đây — đặt làm
             style mặc định của theme để mọi MaterialToolbar tự nhận titleMarginBottom đã sửa
             (chừa đủ chỗ cho dấu tiếng Việt sát đáy chữ), không cần sửa từng file layout riêng lẻ. -->
        <item name="toolbarStyle">@style/App.Toolbar</item>
    </style>

    <style name="App.CardView" parent="Widget.Material3.CardView.Elevated">
        <item name="cardBackgroundColor">@color/surface</item>
        <item name="strokeColor">@color/outline</item>
        <item name="strokeWidth">1.5dp</item>
        <item name="cardCornerRadius">16dp</item>
        <item name="cardElevation">0dp</item>
        <item name="contentPadding">16dp</item>
    </style>

    <style name="App.Button.Primary" parent="Widget.Material3.Button">
        <item name="backgroundTint">@color/primary</item>
        <item name="cornerRadius">14dp</item>
        <item name="android:textColor">@color/on_primary</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <style name="App.Button.Outlined" parent="Widget.Material3.Button.OutlinedButton">
        <item name="strokeColor">@color/outline</item>
        <item name="cornerRadius">14dp</item>
        <item name="android:textColor">@color/primary_dark</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <!-- Nút số tròn cho bàn phím PIN màn Khoá app: hình tròn (cornerRadius = nửa cạnh 72dp),
         nền pastel nhạt, không viền cứng, chữ số lớn dễ bấm — giống bàn phím khoá màn hình
         quen thuộc trên Android/iOS, đồng thời vẫn giữ tông pastel xuyên suốt app. -->
    <style name="App.Button.Numpad" parent="Widget.Material3.Button.TonalButton">
        <item name="backgroundTint">@color/pastel_blue_50</item>
        <item name="cornerRadius">36dp</item>
        <item name="android:layout_width">72dp</item>
        <item name="android:layout_height">72dp</item>
        <item name="android:layout_margin">4dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">24sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="elevation">0dp</item>
    </style>

    <!-- Tab dạng pill cho màn "Chọn thư mục" (Bộ nhớ trong / Thẻ nhớ SD / Lưu trữ mạng),
         selector bg_storage_tab.xml đổi màu nền theo trạng thái android:state_selected. -->
    <style name="App.StorageTab" parent="android:Widget">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginEnd">8dp</item>
        <item name="android:background">@drawable/bg_storage_tab</item>
        <item name="android:paddingHorizontal">16dp</item>
        <item name="android:paddingVertical">8dp</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textColor">@color/storage_tab_text</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>

    <style name="App.TextInputLayout" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxStrokeColor">@color/ti_stroke_selector</item>
        <item name="boxStrokeWidth">1.5dp</item>
        <item name="boxStrokeWidthFocused">2dp</item>
        <item name="boxCornerRadiusTopStart">14dp</item>
        <item name="boxCornerRadiusTopEnd">14dp</item>
        <item name="boxCornerRadiusBottomStart">14dp</item>
        <item name="boxCornerRadiusBottomEnd">14dp</item>
        <item name="hintTextColor">@color/primary</item>
        <item name="android:textColorHint">@color/text_hint</item>
    </style>

    <!-- titleMarginBottom: thuộc tính CHÍNH THỨC của (Material)Toolbar từ AppCompat, chỉ chừa
         thêm khoảng đệm DƯỚI dòng tiêu đề bên trong khung Toolbar cố định — KHÔNG đổi
         layout_height/layout_width của Toolbar (những thuộc tính đó do file layout XML của từng
         activity quyết định, style không ghi đè được LayoutParams). Sửa để dấu tiếng Việt nằm
         sát đáy chữ (dấu nặng, móc dưới ơ/ư) không bị viền TextView tiêu đề cắt mất — không làm
         Toolbar phình cao hơn hay đẩy lệch vị trí trên màn hình. -->
    <style name="App.Toolbar" parent="Widget.Material3.Toolbar">
        <item name="android:background">@color/surface</item>
        <item name="titleTextColor">@color/text_primary</item>
        <item name="titleMarginBottom">4dp</item>
        <item name="android:elevation">0dp</item>
    </style>

    <style name="App.Chip" parent="Widget.Material3.Chip.Assist">
        <item name="chipBackgroundColor">@color/pastel_blue_50</item>
        <item name="chipStrokeColor">@color/outline</item>
        <item name="chipStrokeWidth">1dp</item>
        <item name="android:textColor">@color/primary_dark</item>
    </style>

    <!-- Nút vuông trong thanh công cụ định dạng ghi chú (đậm/nghiêng/gạch chân/màu/cỡ chữ/...).
         parent="" tường minh: tên có dấu chấm (App.Note.ToolbarButton) khiến AAPT tự suy ra cha
         ngầm định là style "App.Note" theo quy ước phân cấp — nhưng style đó không tồn tại
         trong project (chưa từng được định nghĩa), gây lỗi build "resource style/App.Note not
         found". Style này vốn không cần kế thừa gì cả nên khai báo parent rỗng để cắt đứt suy
         luận ngầm định đó. -->
    <style name="App.Note.ToolbarButton" parent="">
        <item name="android:layout_width">44dp</item>
        <item name="android:layout_height">44dp</item>
        <item name="android:layout_margin">2dp</item>
        <item name="android:background">?attr/selectableItemBackgroundBorderless</item>
        <item name="android:padding">10dp</item>
        <item name="android:scaleType">fitCenter</item>
    </style>

    <!-- Nền đen toàn màn hình cho trình xem ảnh/video, thanh trạng thái tối để không chói mắt -->
    <style name="Theme.MyFile.MediaViewer" parent="Theme.Material3.Dark.NoActionBar">
        <item name="android:statusBarColor">@android:color/black</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:navigationBarColor">@android:color/black</item>
        <item name="android:windowBackground">@android:color/black</item>
    </style>

    <!-- Popup menu 3 chấm ở Home: bo góc thay vì hình chữ nhật vuông mặc định của hệ thống -->
    <style name="Widget.App.PopupMenu" parent="Widget.AppCompat.PopupMenu">
        <item name="android:popupBackground">@drawable/bg_popup_menu</item>
        <item name="android:popupElevation">6dp</item>
    </style>

    <style name="ThemeOverlay.App.PopupMenu" parent="ThemeOverlay.Material3">
        <item name="android:popupMenuStyle">@style/Widget.App.PopupMenu</item>
    </style>
</resources>
