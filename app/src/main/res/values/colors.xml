    <!-- Màu chấm thể loại kiểu Samsung My Files — giữ nguyên các màu rực rỡ riêng biệt cho
         từng loại file (ảnh/video/âm thanh/tài liệu...) để dễ phân biệt bằng mắt; KHÔNG đổi
         hết sang tông hồng vì sẽ mất khả năng phân biệt các thể loại trên biểu đồ/danh sách. -->
    <color name="category_photo">#F06292</color>
    <color name="category_video">#A855F7</color>
    <color name="category_audio">#8C6BF2</color>
    <color name="category_doc">#F2A65A</color>
    <color name="category_download">#F472B6</color>
    <color name="category_apk">#66D19E</color>
    <color name="category_archive">#3DBE9A</color>
    <color name="category_other">#C084FC</color>
    <color name="category_trash">#9AA5B1</color>
